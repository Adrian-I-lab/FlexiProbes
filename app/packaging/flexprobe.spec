# -*- mode: python ; coding: utf-8 -*-
# flexiprobes PyInstaller spec — builds a macOS .app or Windows/Linux binary.
#
# Run from the repo root (app/):
#   pyinstaller packaging/flexprobe.spec --noconfirm --clean
# or via the helper:
#   python packaging/build.py --clean

import os
import sys

from PyInstaller.utils.hooks import (
    collect_data_files, collect_dynamic_libs, collect_submodules,
)

block_cipher = None

# Resolve paths relative to this spec file so the build works from any CWD.
# NOTE: PyInstaller's ``SPECPATH`` global is ALREADY the directory containing
# the .spec file (not the file path), so we must NOT take dirname() of it —
# doing so pushed SPEC_DIR up to app/ and made ENTRY/SRC_DIR resolve one level
# too high (PyInstaller then failed with "script app/flexprobe_main.py not
# found"). Use SPECPATH directly.
SPEC_DIR = os.path.abspath(SPECPATH)   # noqa: F821 (PyInstaller global)
APP_DIR = os.path.abspath(os.path.join(SPEC_DIR, ".."))
SRC_DIR = os.path.join(APP_DIR, "src")
ENTRY = os.path.join(SPEC_DIR, "flexprobe_main.py")

# Single source of truth for the bundle version: parse it out of the package
# __init__ (no import, so we avoid pulling in heavy deps at spec-eval time).
def _read_version():
    init = os.path.join(SRC_DIR, "flexprobe", "__init__.py")
    with open(init, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("__version__"):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    raise RuntimeError(f"__version__ not found in {init}")

APP_VERSION = _read_version()

# Collect the real packages (dynamic imports + writers submodules).
hidden = collect_submodules("flexprobe") + collect_submodules("flexprobe_gui")

# primer3-py is a compiled package: it ships TWO C extensions (p3helpers +
# thermoanalysis) and a primer3_config/ thermodynamic-parameter directory.
# collect_submodules only pulls the pure-Python modules, so the earlier builds
# bundled thermoanalysis.so but NOT p3helpers.so — and `import primer3`
# (bindings.py does `from primer3 import ...`) then failed inside the frozen
# app, making every probe's Tm/hairpin come back n/a. Explicitly collect its
# submodules, both .so files, and the thermo-config data so primer3 works.
hidden += collect_submodules("primer3")
primer3_binaries = collect_dynamic_libs("primer3")
primer3_datas = collect_data_files(
    "primer3", includes=["**/primer3_config/**"],
)

# App icons (generated by packaging/make_icons.py).
ASSETS = os.path.join(SPEC_DIR, "assets")
ICON_PNG = os.path.join(ASSETS, "icon.png")
ICON_ICNS = os.path.join(ASSETS, "icon.icns")
ICON_ICO = os.path.join(ASSETS, "icon.ico")
# Per-OS bundle icon, only if it was generated (icns needs macOS).
if sys.platform == "darwin":
    APP_ICON = ICON_ICNS if os.path.exists(ICON_ICNS) else None
elif sys.platform.startswith("win"):
    APP_ICON = ICON_ICO if os.path.exists(ICON_ICO) else None
else:
    APP_ICON = None

# No sample/example sequence data is bundled. Input-format templates live in
# data/templates/ in the source tree and are documented in data/README.md.
# The runtime window icon ships inside the GUI package so QIcon can find it.
datas = []
if os.path.exists(ICON_PNG):
    datas.append((ICON_PNG, "flexprobe_gui/assets"))

# Ship the license + legal notices INSIDE the bundle so the binary carries its
# own GPL-3.0 text + third-party attributions (GPL distribution requirement, and
# the bundled BLAST+ / Qt notices). They land at the bundle root under licenses/.
for _legal in ("LICENSE", "NOTICE"):
    _lp = os.path.join(APP_DIR, _legal)
    if os.path.exists(_lp):
        datas.append((_lp, "licenses"))

# SOURCE-OFFER.txt is a TEMPLATE: GPLv3 §6 requires the written offer to cover
# the Corresponding Source *for this object code*, so the version it names must
# be the version actually being built. Hand-typing it drifts (the 0.4.0 tree
# still shipped an offer declaring 0.3.6). Substitute __version__ here instead.
_offer_src = os.path.join(APP_DIR, "SOURCE-OFFER.txt")
if os.path.exists(_offer_src):
    with open(_offer_src, encoding="utf-8") as _fh:
        _offer_text = _fh.read()
    if "@FLEXIPROBES_VERSION@" not in _offer_text:
        raise RuntimeError(
            f"{_offer_src} no longer contains the @FLEXIPROBES_VERSION@ "
            f"placeholder — the GPLv3 §6 offer would ship an unverified "
            f"hand-typed version. Restore the placeholder."
        )
    # Drop the note that only makes sense while reading the source tree.
    _offer_text = _offer_text.replace(
        "NOTE FOR READERS OF THE SOURCE TREE: in the repository this file is a "
        "template\nand the line above reads \"@FLEXIPROBES_VERSION@\" literally. "
        "The PyInstaller\nspec (packaging/flexprobe.spec) substitutes "
        "flexprobe.__version__ at build time,\nso the copy inside any actual "
        "binary names the version that binary was built\nfrom. Do not hand-edit "
        "the version here.\n\n",
        "",
    )
    _offer_text = _offer_text.replace("@FLEXIPROBES_VERSION@", APP_VERSION)
    _offer_build_dir = os.path.join(SPEC_DIR, "build", "legal")
    os.makedirs(_offer_build_dir, exist_ok=True)
    _offer_out = os.path.join(_offer_build_dir, "SOURCE-OFFER.txt")
    with open(_offer_out, "w", encoding="utf-8") as _fh:
        _fh.write(_offer_text)
    datas.append((_offer_out, "licenses"))

# The vendored third-party license texts (packaging/vendor_licenses.py keeps
# them in sync with constraints.txt). Shipping this directory is what actually
# satisfies GPLv2 §1 / GPLv3 §4 for primer3-py and Qt, and the BSD/MIT notice
# requirements for NumPy and Biopython. It is NOT safe to rely on PyInstaller
# carrying each wheel's *.dist-info into the bundle: it collects imported
# modules, not distribution metadata, and in practice only numpy's survived.
_tpl = os.path.join(APP_DIR, "THIRD-PARTY-LICENSES")
if os.path.isdir(_tpl):
    datas.append((_tpl, "licenses/THIRD-PARTY-LICENSES"))
else:
    raise RuntimeError(
        f"THIRD-PARTY-LICENSES/ not found at {_tpl} — refusing to build a "
        f"binary that would redistribute primer3-py (GPL-2.0-or-later), Qt and "
        f"NumPy without their license texts."
    )

# Bundle BLAST+ (blastn + makeblastdb + blastdbcmd) so the packaged app needs NO separate
# install — flexprobe.blast._bundled_blast_dir() finds them at runtime under
# "blast/bin". The vendored NCBI binaries are platform/arch-specific (and
# self-contained: no external lib/ dir), kept under packaging/vendor/blast/<plat>
# — see that dir's README.md. Pick the subdir matching this build host so the
# .app/.exe/onedir always ships the right ones.
import platform as _platform
_machine = _platform.machine().lower()
if sys.platform == "darwin":
    _blast_plat = "macos-arm64" if _machine in ("arm64", "aarch64") else "macos-x64"
    _blast_tools = ("blastn", "makeblastdb", "blastdbcmd")
elif sys.platform.startswith("win"):
    _blast_plat = "windows-x64"
    _blast_tools = ("blastn.exe", "makeblastdb.exe", "blastdbcmd.exe")
else:
    _blast_plat = "linux-aarch64" if _machine in ("arm64", "aarch64") else "linux-x64"
    _blast_tools = ("blastn", "makeblastdb", "blastdbcmd")
BLAST_VENDOR_BIN = os.path.join(SPEC_DIR, "vendor", "blast", _blast_plat, "bin")
blast_binaries = []
for _tool in _blast_tools:
    _p = os.path.join(BLAST_VENDOR_BIN, _tool)
    if os.path.exists(_p):
        blast_binaries.append((_p, "blast/bin"))
    else:
        print(f"[spec] WARNING: vendored BLAST+ {_tool} not found for "
              f"{_blast_plat} at {_p}; the build will NOT bundle BLAST+.")

# Bundle MAFFT so multi-strain runs get a real multiple alignment with NO
# separate install. flexprobe.consensus._bundled_mafft() finds it at runtime
# under "mafft/mafft.bat" beside "mafft/mafftdir".
#
# What is vendored is MAFFT's official all-in-one / portable package, which
# upstream recommends for precisely this use: the Linux and macOS download
# pages both describe it as intended for redistributing MAFFT inside another
# program package rather than for standalone use. It has the same shape on all
# three platforms (mafft-mac / mafft-linux64 / mafft-win), each a driver named
# mafft.bat beside a mafftdir tree, relocatable as a unit.
#
# Do NOT vendor a distribution build (Homebrew, apt, conda). Those are compiled
# against their build host and are not redistribution artefacts, and they use a
# different layout (bin/mafft plus a separate libexec/mafft) that the runtime
# resolver deliberately does not look for.
if sys.platform == "darwin":
    _mafft_plat = "macos"
elif sys.platform.startswith("win"):
    _mafft_plat = "windows-x64"
else:
    _mafft_plat = "linux-x64"

MAFFT_VENDOR = os.path.join(SPEC_DIR, "vendor", "mafft", _mafft_plat)
mafft_binaries = []
mafft_datas = []
_SCRIPT_EXT = (".bat", ".pl", ".rb", ".sh", ".txt", ".html", ".ps1")
if os.path.isfile(os.path.join(MAFFT_VENDOR, "mafft.bat")):
    for _root, _dirs, _files in os.walk(MAFFT_VENDOR):
        _rel = os.path.relpath(_root, MAFFT_VENDOR)
        _dest = "mafft" if _rel == "." else os.path.join("mafft", _rel)
        for _f in sorted(_files):
            _fp = os.path.join(_root, _f)
            # Executables go through binaries= so PyInstaller keeps the
            # executable bit; scripts and data ride along as datas. mafft.bat
            # is a script, hence consensus._external_msa invoking it through an
            # explicit interpreter rather than exec'ing it.
            if (os.access(_fp, os.X_OK)
                    and not _f.lower().endswith(_SCRIPT_EXT)):
                mafft_binaries.append((_fp, _dest))
            else:
                mafft_datas.append((_fp, _dest))
    print(f"[spec] Bundling MAFFT for {_mafft_plat}: "
          f"{len(mafft_binaries)} executables, {len(mafft_datas)} data files.")
else:
    print(f"[spec] WARNING: vendored MAFFT not found for {_mafft_plat} at "
          f"{MAFFT_VENDOR} (expected mafft.bat there); the build will NOT "
          f"bundle MAFFT and multi-strain runs will fall back to the built-in "
          f"aligner.")

a = Analysis(
    [ENTRY],
    pathex=[SRC_DIR],
    binaries=blast_binaries + primer3_binaries + mafft_binaries,
    datas=datas + primer3_datas + mafft_datas,
    hiddenimports=hidden,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["tkinter"],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

if sys.platform == "darwin":
    exe = EXE(
        pyz, a.scripts, [],
        exclude_binaries=True,
        name="flexiprobes",
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,   # UPX trips antivirus heuristics and can corrupt Qt/numpy libs.
        console=False,
    )
    coll = COLLECT(
        exe, a.binaries, a.zipfiles, a.datas,
        strip=False, upx=False, upx_exclude=[], name="flexiprobes",
    )
    app = BUNDLE(
        coll,
        name="flexiprobes.app",
        icon=APP_ICON,
        bundle_identifier="org.flexiprobes.app",
        info_plist={
            # Display strings only. The bundle is still flexiprobes.app on
            # disk and the identifier is unchanged, so documented paths, the
            # lab-meeting USB instructions and any existing per-user state
            # keep working; only what macOS SHOWS becomes FlexiProbes.
            "CFBundleName": "FlexiProbes",
            "CFBundleDisplayName": "FlexiProbes",
            "CFBundleVersion": APP_VERSION,
            "CFBundleShortVersionString": APP_VERSION,
            "NSHighResolutionCapable": True,
        },
    )
else:
    # onedir (NOT onefile). Qt/PySide6 is tri-licensed LGPL-3.0 / GPL-2.0 /
    # GPL-3.0 and flexiprobes takes it under the GPL-3.0 option, because the
    # combined work is GPL-3.0-or-later. Under that option LGPL-3.0 §4's
    # relink/replace requirement does NOT bind us — the binding obligation is
    # GPLv3's, to convey the Corresponding Source (see ../SOURCE-OFFER.txt).
    #
    # onedir is kept anyway, deliberately: it leaves the Qt shared libraries as
    # separate replaceable files on disk, which keeps the LGPL-3.0 option
    # genuinely exercisable by downstream re-users who prefer it, and keeps the
    # bundled licenses/ folder visible rather than sealed in a self-extracting
    # blob. It also avoids onefile's per-launch extraction cost and macOS
    # code-signing friction. Also avoids UPX (see above).
    # Keep this rationale in sync with ../NOTICE and
    # ../THIRD-PARTY-LICENSES/README.md.
    exe = EXE(
        pyz, a.scripts, [],
        exclude_binaries=True,
        name="flexiprobes",
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=False,
        icon=APP_ICON,
    )
    coll = COLLECT(
        exe, a.binaries, a.zipfiles, a.datas,
        strip=False, upx=False, upx_exclude=[], name="flexiprobes",
    )
